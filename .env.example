# Copy to .env (or .env.local) and adjust. Real .env files are git-ignored.
# Values are validated at startup in src/config/env.validation.ts.

# development | test | staging | production
NODE_ENV=development
PORT=3000
# Default IANA time zone for new tenants
DEFAULT_TIMEZONE=Europe/Zurich

# PostgreSQL (pgvector) connection string
DATABASE_URL=postgresql://rs:rs@localhost:5432/rs

# JWT secrets: at least 32 characters, must differ from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d
